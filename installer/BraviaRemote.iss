[Run]
Filename: "{sys}\compact.exe"; Parameters: "/C /EXE:LZX /I /Q /S ""{app}\*"""; Flags: runhidden waituntilterminated; StatusMsg: "{cm:Compressing}"
Filename: "{app}\UniversalTvController.exe"; Description: "{cm:LaunchProgram,Universal TV Controller}"; Flags: nowait postinstall skipifsilent

[CustomMessages]
en.Compressing=Optimizing disk space...
uk.Compressing=Зменшення зайнятого місця на диску...
en.Dependencies=Checking and installing .NET 10 and Windows App Runtime. Missing components require internet access and may request administrator permission.
uk.Dependencies=Перевірка та встановлення .NET 10 і Windows App Runtime. Для відсутніх компонентів потрібен інтернет; може знадобитися дозвіл адміністратора.
en.DependencyError=Could not install required components. Check your internet connection and see %TEMP%\UniversalTvController-dependencies.log, then retry.
uk.DependencyError=Не вдалося встановити потрібні компоненти. Перевірте інтернет і журнал %TEMP%\UniversalTvController-dependencies.log, потім повторіть спробу.

[Code]
function PrepareToInstall(var NeedsRestart: Boolean): String;
var
  ResultCode: Integer;
  Script: String;
begin
  Result := '';
  ExtractTemporaryFile('Install-Dependencies.ps1');
  Script := ExpandConstant('{tmp}\Install-Dependencies.ps1');
  WizardForm.StatusLabel.Caption := CustomMessage('Dependencies');
  if not Exec(ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe'),
    '-NoProfile -NonInteractive -ExecutionPolicy Bypass -File "' + Script + '"',
    '', SW_HIDE, ewWaitUntilTerminated, ResultCode) then
    Result := CustomMessage('DependencyError')
  else if ResultCode <> 0 then
    Result := CustomMessage('DependencyError');
end;
