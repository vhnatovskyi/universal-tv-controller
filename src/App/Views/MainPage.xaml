<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BraviaRemote.MainPage" BackgroundColor="#101820">
    <ContentPage.Resources>
        <Style x:Key="StandardButtonStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#1B2635" />
            <Setter Property="BorderColor" Value="#2C3A4D" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="TextColor" Value="#F3F6FA" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="MinimumHeightRequest" Value="{OnPlatform 44, WinUI=36}" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal" />
                        <VisualState Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#293E52" />
                                <Setter Property="BorderColor" Value="#5885A0" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#38627F" />
                                <Setter Property="BorderColor" Value="#9BDBF9" />
                                <Setter Property="Scale" Value="0.94" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState Name="Disabled">
                            <VisualState.Setters>
                                <Setter Property="Opacity" Value="0.6" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource StandardButtonStyle}" />
    </ContentPage.Resources>
    <Grid RowDefinitions="Auto,Auto,*" SafeAreaEdges="Container">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8" Padding="12,6" BackgroundColor="#141E2B">
            <Button x:Name="MenuButton" Text="☰" FontSize="19" WidthRequest="40"
                    BackgroundColor="Transparent" BorderWidth="0" Clicked="OnToggleMenu"
                    SemanticProperties.Description="{DynamicResource Loc.Menu}" />
            <Label x:Name="ToolbarTitle" Grid.Column="1" Text="{DynamicResource Loc.Remote}"
                   FontSize="18" FontAttributes="Bold" TextColor="#F3F6FA"
                   VerticalOptions="Center" LineBreakMode="TailTruncation" />
            <Border x:Name="ActiveAppChip" Grid.Column="2" IsVisible="False" Padding="5" VerticalOptions="Center"
                    BackgroundColor="#1B2635" Stroke="#2C3A4D" StrokeShape="RoundRectangle 8">
                <Image x:Name="ActiveAppIcon" WidthRequest="24" HeightRequest="24" />
            </Border>
            <Border x:Name="VolumeChip" Grid.Column="3" BackgroundColor="#1B2635"
                    Stroke="#2C3A4D" StrokeShape="RoundRectangle 8" Padding="9,4"
                    VerticalOptions="Center" IsVisible="False">
                <HorizontalStackLayout Spacing="7">
                    <Label Text="{DynamicResource Loc.Volume}" TextColor="#B4D6E8" FontSize="13" VerticalOptions="Center" />
                    <Label x:Name="VolumeValue" Text="—" TextColor="#83DFF6"
                           FontAttributes="Bold" FontSize="16" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
            <Button x:Name="CheckButton" Grid.Column="4" Text="⟳" FontSize="19" WidthRequest="38"
                    Padding="0" Clicked="OnCheck" IsVisible="False"
                    ToolTipProperties.Text="{DynamicResource Loc.CheckConnection}"
                    SemanticProperties.Description="{DynamicResource Loc.CheckConnection}" />
        </Grid>
        <Border x:Name="UpdateBanner" Grid.Row="1" Margin="12,8,12,0" Padding="10,4"
                Stroke="#396077" StrokeShape="RoundRectangle 9" BackgroundColor="#1C354A" IsVisible="False">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label x:Name="UpdateLabel" TextColor="#E4EDF9" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="{DynamicResource Loc.OpenRelease}" Clicked="OnOpenRelease" />
            </Grid>
        </Border>
        <ScrollView x:Name="ScreenScroll" Grid.Row="2" SizeChanged="OnRemoteViewportChanged">
          <VerticalStackLayout Padding="12,12" Spacing="8" MaximumWidthRequest="480" HorizontalOptions="Fill">
            <VerticalStackLayout x:Name="DiscoveryPanel" Padding="4,12" Spacing="16" IsVisible="False">
                <Label Text="{DynamicResource Loc.DiscoveryHelp}" TextColor="#A9BDCF" />
                <HorizontalStackLayout Spacing="12" HorizontalOptions="Center" Padding="0,16">
                    <ActivityIndicator x:Name="DiscoverySpinner" Color="#72CCFA" WidthRequest="28" HeightRequest="28" />
                    <Label x:Name="DiscoveryStatus" TextColor="#A9BDCF" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <VerticalStackLayout x:Name="DeviceCards" Spacing="10" />
                <Button x:Name="FindDevicesButton" Text="{DynamicResource Loc.FindDevices}" Clicked="OnFindDevices" />
                <Button Text="{DynamicResource Loc.Cancel}" Clicked="OnCancelDiscovery" BackgroundColor="Transparent" />
            </VerticalStackLayout>
            <VerticalStackLayout x:Name="UpdatesPanel" Padding="12" Spacing="10" IsVisible="False">
                <Label x:Name="InstalledVersionLabel" TextColor="#95A3B8" FontSize="11" />
                <Label x:Name="LatestVersionLabel" TextColor="#83DFF6" />
                <Button x:Name="InstallUpdateButton" Clicked="OnInstallUpdate" IsEnabled="False" />
                <Label x:Name="UpdateInstallHelpLabel" Text="{DynamicResource Loc.UpdateInstallHelp}" TextColor="#95A3B8" FontSize="11" />
                <HorizontalStackLayout Spacing="12">
                    <ActivityIndicator x:Name="UpdateDownloadSpinner" Color="#72CCFA" IsVisible="False" />
                    <Button x:Name="CancelUpdateButton" Text="{DynamicResource Loc.Cancel}" Clicked="OnCancelUpdate" IsVisible="False" />
                </HorizontalStackLayout>
                <Label x:Name="UpdateInstallStatusLabel" TextColor="#95A3B8" FontSize="11" IsVisible="False" />
                <Picker x:Name="ReleasePicker" Title="{DynamicResource Loc.ChooseRelease}" TitleColor="#95A3B8"
                        TextColor="White" BackgroundColor="#1B2635" SelectedIndexChanged="OnReleaseSelected" />
                <Label x:Name="ReleaseStatusLabel" TextColor="#95A3B8" FontSize="11" />
                <HorizontalStackLayout Spacing="12">
                    <Button x:Name="SelectedReleaseButton" Text="{DynamicResource Loc.OpenRelease}" Clicked="OnOpenSelectedRelease" IsEnabled="False" />
                    <Button x:Name="CheckUpdatesButton" Text="{DynamicResource Loc.CheckUpdates}" Clicked="OnCheckUpdates" />
                </HorizontalStackLayout>
                <Border BackgroundColor="#1B2635" Stroke="#2C3A4D" StrokeShape="RoundRectangle 12" Padding="14">
                    <Label x:Name="ReleaseNotesLabel" TextColor="#F3F6FA" FontSize="14" LineBreakMode="WordWrap" />
                </Border>
            </VerticalStackLayout>
            <VerticalStackLayout x:Name="AboutPanel" Padding="4" Spacing="10" IsVisible="False">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <Image Source="remote_mark.png" WidthRequest="72" HeightRequest="72" />
                    <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                        <Label Text="{DynamicResource Loc.AboutHeading}" FontSize="22" FontAttributes="Bold" TextColor="#F3F6FA" />
                        <Label x:Name="AboutVersionLabel" FontSize="11" TextColor="#95A3B8" />
                    </VerticalStackLayout>
                </Grid>
                <Border BackgroundColor="#1B2635" Stroke="#2C3A4D" StrokeShape="RoundRectangle 12" Padding="14">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{DynamicResource Loc.Developer}" TextColor="#95A3B8" FontSize="11" />
                        <Label Text="Vladyslav Hnatovskyi" FontSize="20" FontAttributes="Bold" TextColor="#F3F6FA" />
                        <Button Text="GitHub" Clicked="OnOpenRepository" />
                        <Button Text="LinkedIn" Clicked="OnOpenLinkedIn" />
                        <Button Text="vhnatovskyi@hotmail.com" Clicked="OnOpenEmail" />
                    </VerticalStackLayout>
                </Border>
                <Label Text="{DynamicResource Loc.AboutDescription}" TextColor="#95A3B8" FontSize="11" />
            </VerticalStackLayout>
            <VerticalStackLayout x:Name="ProfileControls" Spacing="8" IsVisible="False">
                <Label Text="{DynamicResource Loc.Profiles}" FontSize="20" FontAttributes="Bold" TextColor="#F3F7FF" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Picker x:Name="ProfilePicker" Title="{DynamicResource Loc.ChooseProfile}" TitleColor="#ABBDD8"
                            TextColor="White" BackgroundColor="#1B2635" MinimumHeightRequest="48"
                            SelectedIndexChanged="OnProfileChanged" SemanticProperties.Description="{DynamicResource Loc.Profile}" />
                    <Button Grid.Column="1" Text="{DynamicResource Loc.AddProfile}" Clicked="OnAddProfile" />
                </Grid>
                <Label x:Name="DefaultLabel" TextColor="#83DFF6" />
                <Grid x:Name="ProfileActions" ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Text="{DynamicResource Loc.Edit}" Clicked="OnEditProfile" />
                    <Button x:Name="DefaultButton" Grid.Column="1" Text="{DynamicResource Loc.SetDefault}" Clicked="OnSetDefault" />
                </Grid>
                <VerticalStackLayout x:Name="ProfilePairingControls" Spacing="6" Margin="0,4,0,0">
                    <Label Text="{DynamicResource Loc.PairingHelp}" TextColor="#95A3B8" FontSize="12" />
                    <Button Text="{DynamicResource Loc.PairTv}" Clicked="OnPairTv" />
                </VerticalStackLayout>
                <Button x:Name="ShortcutSettingsButton" Text="{DynamicResource Loc.ConfigureShortcuts}" Clicked="OnOpenShortcuts" />
                <Label Text="{DynamicResource Loc.Language}" TextColor="#E4EDF9" Margin="0,8,0,0" />
                <Picker x:Name="LanguagePicker" TextColor="White" BackgroundColor="#1B2635"
                        SelectedIndexChanged="OnLanguageChanged" SemanticProperties.Description="{DynamicResource Loc.Language}" />
                <Label x:Name="VersionLabel" TextColor="#ABBDD8" FontSize="13" />
            </VerticalStackLayout>
            <VerticalStackLayout x:Name="Onboarding" Spacing="8" IsVisible="False">
                <Label Text="{DynamicResource Loc.Onboarding}" TextColor="#ABBDD8" />
                <Button Text="{DynamicResource Loc.AddProfile}" Clicked="OnAddProfile" />
            </VerticalStackLayout>
            <VerticalStackLayout x:Name="ShortcutEditor" IsVisible="False" Spacing="8">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Picker x:Name="ShortcutPicker" Title="{DynamicResource Loc.ChooseShortcut}" TitleColor="#ABBDD8"
                            TextColor="White" BackgroundColor="#1B2635"
                            SelectedIndexChanged="OnShortcutSelected" />
                    <Button Grid.Column="1" Text="{DynamicResource Loc.NewShortcut}" Clicked="OnNewShortcut" />
                </Grid>
                <Picker x:Name="AppPicker" Title="{DynamicResource Loc.ChooseTvApp}" TitleColor="#ABBDD8"
                        TextColor="White" BackgroundColor="#1B2635" SelectedIndexChanged="OnAppSelected"
                        SemanticProperties.Description="{DynamicResource Loc.ChooseTvApp}" />
                <Label Text="{DynamicResource Loc.ShortcutName}" TextColor="#E4EDF9" />
                <Entry x:Name="ShortcutName" Placeholder="Netflix, YouTube, Kyivstar TV…" MaxLength="40"
                       TextColor="White" PlaceholderColor="#ABBDD8" BackgroundColor="#1B2635" />
                <Label x:Name="ShortcutError" IsVisible="False" TextColor="#FFB8B8" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Text="{DynamicResource Loc.Save}" Clicked="OnSaveShortcut" />
                    <Button x:Name="RemoveShortcutButton" Grid.Column="1" Text="{DynamicResource Loc.Delete}" Clicked="OnRemoveShortcut" />
                </Grid>
                <Button Text="{DynamicResource Loc.BackToSettings}" Clicked="OnCloseShortcuts" />
            </VerticalStackLayout>
            <VerticalStackLayout x:Name="ProfileEditor" IsVisible="False" Spacing="8">
                <Label Text="{DynamicResource Loc.ProfileName}" TextColor="#E4EDF9" />
                <Entry x:Name="ProfileNameEntry" Placeholder="{DynamicResource Loc.ProfileExample}" MaxLength="60"
                       TextColor="White" PlaceholderColor="#ABBDD8" BackgroundColor="#1B2635"
                       SemanticProperties.Description="{DynamicResource Loc.ProfileName}" />
                <Button x:Name="SelectedDeviceButton" Text="{DynamicResource Loc.SelectTv}" Clicked="OnChooseDevice" />
                <Label x:Name="EditorError" IsVisible="False" TextColor="#FFB8B8" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button x:Name="SaveProfileButton" Text="{DynamicResource Loc.PairAndSave}" Clicked="OnSaveProfile" />
                    <Button Grid.Column="1" Text="{DynamicResource Loc.Cancel}" Clicked="OnCancelProfile" />
                </Grid>
            </VerticalStackLayout>
            <VerticalStackLayout x:Name="RemoteButtons" Spacing="8">
                <VerticalStackLayout.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource StandardButtonStyle}">
                        <Setter Property="HeightRequest" Value="{DynamicResource RemoteButtonHeight}" />
                    </Style>
                </VerticalStackLayout.Resources>
                <Grid x:Name="QuickButtons" ColumnDefinitions="*,*,*" ColumnSpacing="8" RowSpacing="8" />
                <Button x:Name="PowerButton" ImageSource="control_power.png"
                        WidthRequest="{DynamicResource RemoteButtonHeight}" HeightRequest="{DynamicResource RemoteButtonHeight}"
                        MinimumWidthRequest="44" MinimumHeightRequest="44" CornerRadius="100" Padding="0"
                        HorizontalOptions="Center" BackgroundColor="#1B2937" BorderColor="#40576D" BorderWidth="1.5"
                        Clicked="OnTogglePower" SemanticProperties.Description="{DynamicResource Loc.PowerToggle}"
                        ToolTipProperties.Text="{DynamicResource Loc.PowerToggle}">
                </Button>
                <Border x:Name="DirectionPad" HorizontalOptions="Center" WidthRequest="204" HeightRequest="204" Padding="10"
                        Stroke="#3B526C" StrokeThickness="1.5" StrokeShape="RoundRectangle 160">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#25374C" Offset="0" />
                            <GradientStop Color="#131E2A" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="*,*,*" ColumnSpacing="2" RowSpacing="2">
                        <Grid.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource StandardButtonStyle}">
                                <Setter Property="CornerRadius" Value="100" />
                                <Setter Property="BackgroundColor" Value="Transparent" />
                                <Setter Property="BorderWidth" Value="0" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </Grid.Resources>
                        <Button Grid.Column="1" Text="⌃" FontSize="26" CommandParameter="9" Clicked="OnKey" SemanticProperties.Description="{DynamicResource Loc.Up}" />
                        <Button Grid.Row="1" Text="‹" FontSize="29" CommandParameter="12" Clicked="OnKey" SemanticProperties.Description="{DynamicResource Loc.Left}" />
                        <Button Grid.Column="1" Grid.Row="1" Text="OK" Padding="0" CommandParameter="13" Clicked="OnKey"
                                SemanticProperties.Description="{DynamicResource Loc.Confirm}" BackgroundColor="#304E65" BorderWidth="1.5" BorderColor="#72CCFA" TextColor="#C6EFFF" FontAttributes="Bold" />
                        <Button Grid.Column="2" Grid.Row="1" Text="›" FontSize="29" CommandParameter="11" Clicked="OnKey" SemanticProperties.Description="{DynamicResource Loc.Right}" />
                        <Button Grid.Column="1" Grid.Row="2" Text="⌄" FontSize="26" CommandParameter="10" Clicked="OnKey" SemanticProperties.Description="{DynamicResource Loc.Down}" />
                    </Grid>
                </Border>
                <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                    <Button Text="↶" FontSize="24" CommandParameter="8" Clicked="OnKey" SemanticProperties.Description="{DynamicResource Loc.Back}" ToolTipProperties.Text="{DynamicResource Loc.Back}" />
                    <Button Grid.Column="1" ImageSource="control_home.png" CommandParameter="6" Clicked="OnKey" SemanticProperties.Description="{DynamicResource Loc.Home}" ToolTipProperties.Text="{DynamicResource Loc.Home}" />
                    <Button Grid.Column="2" ImageSource="control_input.png" Clicked="OnInputs" SemanticProperties.Description="{DynamicResource Loc.Inputs}" ToolTipProperties.Text="{DynamicResource Loc.Inputs}" />
                    <Button Grid.Row="1" Text="−" FontSize="25" TextColor="#A1CEEC" CommandParameter="31" Clicked="OnKey" SemanticProperties.Description="{DynamicResource Loc.VolumeDown}" ToolTipProperties.Text="{DynamicResource Loc.VolumeDown}" />
                    <Button Grid.Column="1" Grid.Row="1" ImageSource="control_mute.png" CommandParameter="32" Clicked="OnKey" SemanticProperties.Description="{DynamicResource Loc.Mute}" ToolTipProperties.Text="{DynamicResource Loc.Mute}" />
                    <Button Grid.Column="2" Grid.Row="1" Text="+" FontSize="25" TextColor="#A1CEEC" CommandParameter="30" Clicked="OnKey" SemanticProperties.Description="{DynamicResource Loc.VolumeUp}" ToolTipProperties.Text="{DynamicResource Loc.VolumeUp}" />
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button x:Name="VoiceButton" ImageSource="control_mic.png" Text="{DynamicResource Loc.VoiceInput}" TextColor="#D4BDFB"
                            BackgroundColor="#29243D" BorderColor="#584879" Clicked="OnVoiceInput" />
                    <Button Grid.Column="1" ImageSource="control_settings.png" Text="{DynamicResource Loc.TvSettings}"
                            CommandParameter="7" Clicked="OnKey" SemanticProperties.Description="{DynamicResource Loc.TvSettings}" />
                </Grid>
            </VerticalStackLayout>
          </VerticalStackLayout>
        </ScrollView>
        <Border x:Name="VoicePanel" Grid.Row="2" IsVisible="False" BackgroundColor="#131E2A" Stroke="#584879"
                StrokeShape="RoundRectangle 16" Padding="20" Margin="20" VerticalOptions="Center">
            <VerticalStackLayout Spacing="14">
                <ActivityIndicator x:Name="VoiceSpinner" Color="#D4BDFB" WidthRequest="40" HeightRequest="40" />
                <Label x:Name="VoiceStatus" TextColor="#E6D9FF" HorizontalTextAlignment="Center" />
                <Button Text="{DynamicResource Loc.Cancel}" Clicked="OnCancelVoice" />
            </VerticalStackLayout>
        </Border>
        <Border x:Name="Toast" Grid.Row="2" IsVisible="False" InputTransparent="True"
                VerticalOptions="End" Margin="12,0,12,12" Padding="12,10" StrokeShape="RoundRectangle 10">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Label x:Name="ToastIcon" FontSize="16" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
                <Label x:Name="ToastText" Grid.Column="1" TextColor="White" VerticalOptions="Center" />
            </Grid>
        </Border>
        <Grid x:Name="MenuOverlay" Grid.Row="1" Grid.RowSpan="2" ColumnDefinitions="170,*" IsVisible="False">
            <BoxView Grid.ColumnSpan="2" Color="#70070D18" SemanticProperties.Description="{DynamicResource Loc.CloseMenu}">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCloseMenu" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <VerticalStackLayout Padding="5" Spacing="4" BackgroundColor="#141E2B">
                <Button x:Name="RemoteMenuButton" Text="{DynamicResource Loc.Remote}" Clicked="OnShowRemote" BorderWidth="0" />
                <Button x:Name="SettingsMenuButton" Text="{DynamicResource Loc.Settings}" Clicked="OnShowSettings" BorderWidth="0" />
                <Button x:Name="UpdatesMenuButton" Text="{DynamicResource Loc.Updates}" Clicked="OnShowUpdates" BorderWidth="0" />
                <Button x:Name="AboutMenuButton" Text="{DynamicResource Loc.About}" Clicked="OnShowAbout" BorderWidth="0" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
